server {
    listen 443 ssl http2;
    server_name staging.example.internal;

    # Provider-managed certificate paths belong outside source control.
    ssl_certificate     /run/secrets/staging-cert.pem;
    ssl_certificate_key /run/secrets/staging-key.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 64k;

    location / {
        proxy_pass http://share_link_student_staging;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Platform-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_hide_header X-Powered-By;
    }
}

server {
    listen 80;
    server_name staging.example.internal;
    return 308 https://$host$request_uri;
}
