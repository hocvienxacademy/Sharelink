# Documentation only. Store real values in Render Environment/Secrets.
NODE_ENV=production
APP_ENV=production
DATABASE_URL=postgresql://render_app:CHANGE_ME@render-db-internal/sharelinkstudent
PRODUCTION_DATABASE_ALLOWED_HOSTS=render-db-internal
PRODUCTION_DATABASE_ALLOWED_NAMES=sharelinkstudent
RATE_LIMIT_REDIS_REST_URL=https://CHANGE_ME.upstash.io
PRODUCTION_REDIS_ALLOWED_HOSTS=CHANGE_ME.upstash.io
RATE_LIMIT_REDIS_REST_TOKEN=CHANGE_ME
RATE_LIMIT_KEY_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
LOG_LEVEL=info
REQUEST_BODY_MAX_BYTES=65536
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_SECONDS=900
# Render provides RENDER_EXTERNAL_URL and RENDER_GIT_COMMIT automatically.
# Enable only after HTTPS and the final domain are stable.
ENABLE_HSTS=false
# Set only when the named header is overwritten by a trusted reverse proxy.
TRUSTED_PROXY_IP_HEADER=
