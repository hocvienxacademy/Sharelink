# Documentation only. Store real values in the deployment secret manager.
NODE_ENV=production
APP_ENV=staging
DATABASE_URL=postgresql://staging_app:CHANGE_ME@staging-db.internal:5432/student_registration_staging?sslmode=require
RATE_LIMIT_REDIS_REST_URL=https://staging-rate-limit.example.invalid
RATE_LIMIT_REDIS_REST_TOKEN=CHANGE_ME
RATE_LIMIT_KEY_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
APP_BASE_URL=https://staging.example.internal
RELEASE_SHA=CHANGE_ME_TO_THE_EXACT_GIT_COMMIT
LOG_LEVEL=info
REQUEST_BODY_MAX_BYTES=65536
# Set only when the named header is overwritten by the trusted reverse proxy.
TRUSTED_PROXY_IP_HEADER=
# Enable only after HTTPS is stable and verified end-to-end.
ENABLE_HSTS=false
