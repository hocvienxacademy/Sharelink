generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model admission_periods {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String               @unique(map: "uq_admission_periods_code") @db.VarChar(50)
  name               String               @db.VarChar(255)
  start_date         DateTime?            @db.Date
  end_date           DateTime?            @db.Date
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  applications       applications[]
  registration_links registration_links[]
}

model app_sessions {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.Json
  expire DateTime @db.Timestamptz(6)

  @@index([expire], map: "idx_app_sessions_expire")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model application_relatives {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id String       @db.Uuid
  position       Int          @db.SmallInt
  full_name      String?      @db.VarChar(150)
  relationship   String?      @db.VarChar(100)
  occupation     String?      @db.VarChar(255)
  phone          String?      @db.VarChar(15)
  address        String?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @db.Timestamptz(6)
  applications   applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_application_relatives_application")

  @@unique([application_id, position], map: "uq_application_relatives_position")
}

/// Stores a revocable, hashed capability used by a submitted applicant to download the Word export again.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model application_export_credentials {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id  String       @unique(map: "uq_application_export_credentials_application") @db.Uuid
  secret_hash     String       @db.VarChar(64)
  failed_attempts Int          @default(0) @db.SmallInt
  locked_until    DateTime?    @db.Timestamptz(6)
  revoked_at      DateTime?    @db.Timestamptz(6)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @db.Timestamptz(6)
  applications    applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_application_export_credentials_application")

  @@index([locked_until], map: "idx_application_export_credentials_locked_until")
}

model application_status_histories {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id  String              @db.Uuid
  previous_status application_status?
  new_status      application_status
  changed_by      String?             @db.Uuid
  reason          String?
  metadata        Json                @default("{}")
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  applications    applications        @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_application_status_histories_application")
  users           users?              @relation(fields: [changed_by], references: [id], onUpdate: NoAction, map: "fk_application_status_histories_changed_by")

  @@index([application_id, created_at(sort: Desc)], map: "idx_application_status_histories_application_created")
}

