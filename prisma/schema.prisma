// ---------------------------------------------------------------------------
// Student mailing: procedure emails (TBHTTTNH, HĐHPĐ1) with generated notices
// and accounting invoices. CHECK constraints and partial indexes are defined
// in prisma/migrations/20261020120000_add_student_mailing/migration.sql.
// ---------------------------------------------------------------------------

/// Image layers of a notice (watermark, stamp, signature). Shared by template
/// versions so saving a new version does not duplicate the bytes.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model notice_assets {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slot                   notice_asset_slot
  content                Bytes
  mime_type              String             @db.VarChar(50)
  sha256                 String             @db.Char(64)
  byte_size              Int
  uploaded_by            String             @db.Uuid
  created_at             DateTime           @default(now()) @db.Timestamptz(6)
  users                  users              @relation("notice_assets_uploaded_by", fields: [uploaded_by], references: [id], onUpdate: NoAction, map: "fk_notice_assets_uploaded_by")
  watermark_of_templates notice_templates[] @relation("notice_templates_watermark")
  stamp_of_templates     notice_templates[] @relation("notice_templates_stamp")
  signature_of_templates notice_templates[] @relation("notice_templates_signature")

  @@unique([slot, sha256], map: "uq_notice_assets_slot_sha256")
}

/// Immutable versions of a notice template; editing creates a new version.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model notice_templates {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  procedure          mail_procedure
  version            Int
  name               String           @db.VarChar(150)
  settings           Json
  layout             Json
  watermark_asset_id String?          @db.Uuid
  stamp_asset_id     String?          @db.Uuid
  signature_asset_id String?          @db.Uuid
  is_default         Boolean          @default(false)
  created_by         String           @db.Uuid
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  users              users            @relation("notice_templates_created_by", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_notice_templates_created_by")
  watermark_asset    notice_assets?   @relation("notice_templates_watermark", fields: [watermark_asset_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_notice_templates_watermark_asset")
  stamp_asset        notice_assets?   @relation("notice_templates_stamp", fields: [stamp_asset_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_notice_templates_stamp_asset")
  signature_asset    notice_assets?   @relation("notice_templates_signature", fields: [signature_asset_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_notice_templates_signature_asset")
  mail_batches       mail_batches[]
  mail_documents     mail_documents[]

  @@unique([procedure, version], map: "uq_notice_templates_procedure_version")
  @@unique([procedure], map: "uq_notice_templates_default", where: raw("is_default"))
}

/// Immutable versions of the default email content of a procedure.
